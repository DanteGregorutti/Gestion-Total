rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: products
    // Fields:
    //   - codigo: string (required)
    //   - procedencia: string (required, enum: Legítimo, Genérico, Importado)
    //   - estado: string (required, enum: Nuevo, Usado)
    //   - cantidad: number (required)
    //   - descripcion: string (required)
    //   - ubicacion: string (required)
    //   - almacenId: string (required)
    //   - precio: number (required)
    //   - costo: number (optional)
    //   - imagenUrl: string (optional)
    //   - createdBy: string (required, immutable)
    //   - createdAt: timestamp (required, immutable)
    //   - updatedAt: timestamp (required)
    //
    // Collection: warehouses
    // Fields:
    //   - nombre: string (required)
    //   - descripcion: string (optional)
    //   - ubicacion: string (optional)
    //   - createdBy: string (required, immutable)
    //   - createdAt: timestamp (required, immutable)
    //
    // Collection: clients
    // Fields:
    //   - nombre: string (required)
    //   - email: string (optional)
    //   - telefono: string (optional)
    //   - direccion: string (optional)
    //   - createdBy: string (required)
    //   - createdAt: timestamp (required)
    //
    // Collection: suppliers
    // Fields:
    //   - nombre: string (required)
    //   - contacto: string (optional)
    //   - email: string (optional)
    //   - telefono: string (optional)
    //   - createdBy: string (required)
    //   - createdAt: timestamp (required)
    //
    // Collection: sales
    // Fields:
    //   - productId: string (required)
    //   - productNombre: string (required)
    //   - cantidad: number (required)
    //   - precio: number (required)
    //   - total: number (required)
    //   - clientId: string (optional)
    //   - clientNombre: string (optional)
    //   - fecha: timestamp (required)
    //   - createdBy: string (required)
    //
    // Collection: users
    // Fields:
    //   - uid: string (required)
    //   - email: string (required)
    //   - role: string (required, enum: admin, employee)
    //
    // Collection: combos
    // Fields:
    //   - nombre: string (required)
    //   - precioTotal: number (required)
    //   - items: array (required)
    //   - createdBy: string (required)
    //   - createdAt: timestamp (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isDocOwner() {
      return isAuthenticated() && 
             resource != null && 
             (resource.data.get('createdBy', '') == request.auth.uid || 
              resource.data.get('userId', '') == request.auth.uid);
    }

    function isAdmin() {
      return isAuthenticated() && 
        (
          request.auth.uid == 'lDS1dQuicIXFpzUonwzcGjMT1Wv1' ||
          request.auth.uid == 'B00c6vIn0QO6o5M37xNbe27hXyE3' ||
          request.auth.token.get('email', '').lower() == 'pulsestore07@gmail.com' ||
          request.auth.token.get('email', '').lower() == 'tallergregorutti@gmail.com' ||
          request.auth.token.get('email', '').lower() == 'gregoruttidante@gmail.com' ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'none') == 'admin')
        );
    }

    function isEmployee() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'none') == 'employee';
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidProduct(data) {
      return hasRequiredFields(['codigo', 'procedencia', 'estado', 'cantidad', 'ubicacion', 'almacenId', 'createdBy']) &&
             data.codigo is string && data.codigo.size() > 0 && data.codigo.size() < 100 &&
             data.procedencia in ['Legítimo', 'Genérico', 'Importado'] &&
             data.estado in ['Nuevo', 'Usado'] &&
             data.cantidad is number &&
             (!('descripcion' in data) || (data.descripcion is string && data.descripcion.size() < 1000)) &&
             data.ubicacion is string && data.ubicacion.size() < 200 &&
             data.almacenId is string &&
             (!('precio' in data) || (data.precio is number && data.precio >= 0));
    }

    function isValidWarehouse(data) {
      return hasRequiredFields(['nombre', 'createdBy']) &&
             data.nombre is string && data.nombre.size() > 0 && data.nombre.size() < 100;
    }

    function isValidClient(data) {
      return hasRequiredFields(['nombre', 'createdBy']) &&
             data.nombre is string && data.nombre.size() > 0 && data.nombre.size() < 100;
    }

    function isValidSupplier(data) {
      return hasRequiredFields(['nombre', 'createdBy']) &&
             data.nombre is string && data.nombre.size() > 0 && data.nombre.size() < 100;
    }

    function isValidCombo(data) {
      return hasRequiredFields(['nombre', 'precioTotal', 'items', 'createdBy']) &&
             data.nombre is string && data.nombre.size() > 0 && data.nombre.size() < 100 &&
             data.precioTotal is number && data.precioTotal >= 0 &&
             data.items is list && data.items.size() > 0 && data.items.size() < 50 &&
             data.createdBy is string;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Products
    match /products/{productId} {
      allow read: if isAuthenticated() && (isAdmin() || isEmployee() || resource.data.get('createdBy', '') == request.auth.uid);
      allow create: if isAuthenticated() && (isAdmin() || (isEmployee() && isValidProduct(request.resource.data) && request.resource.data.get('createdBy', '') == request.auth.uid));
      allow update: if isAuthenticated() && (isAdmin() || ( (isDocOwner() || isEmployee()) && (isValidProduct(request.resource.data) || request.resource.data.keys().hasOnly(['cantidad', 'updatedAt'])) ));
      allow delete: if isAuthenticated() && isAdmin();
    }

    // Warehouses
    match /warehouses/{warehouseId} {
      allow read: if isAuthenticated() && (isAdmin() || isEmployee() || resource.data.get('createdBy', '') == request.auth.uid);
      allow create: if isAuthenticated() && isAdmin() && request.resource.data.get('createdBy', '') == request.auth.uid;
      allow update: if isAuthenticated() && (isAdmin() || (isDocOwner() && isValidWarehouse(request.resource.data)));
      allow delete: if isAuthenticated() && isAdmin();
    }

    // Clients
    match /clients/{clientId} {
      allow read: if isAuthenticated() && (isAdmin() || isEmployee() || resource.data.get('createdBy', '') == request.auth.uid);
      allow create: if isAuthenticated() && (isAdmin() || (isEmployee() && isValidClient(request.resource.data) && request.resource.data.get('createdBy', '') == request.auth.uid));
      allow update: if isAuthenticated() && (isAdmin() || ( (isDocOwner() || isEmployee()) && isValidClient(request.resource.data) ));
      allow delete: if isAuthenticated() && isAdmin();
    }

    // Suppliers
    match /suppliers/{supplierId} {
      allow read: if isAuthenticated() && (isAdmin() || isEmployee() || resource.data.get('createdBy', '') == request.auth.uid);
      allow create: if isAuthenticated() && (isAdmin() || (isEmployee() && isValidSupplier(request.resource.data) && request.resource.data.get('createdBy', '') == request.auth.uid));
      allow update: if isAuthenticated() && (isAdmin() || ( (isDocOwner() || isEmployee()) && isValidSupplier(request.resource.data) ));
      allow delete: if isAuthenticated() && isAdmin();
    }

    // Movements
    match /movements/{movementId} {
      allow read: if isAuthenticated() && (isAdmin() || isEmployee() || resource.data.get('createdBy', '') == request.auth.uid);
      allow create: if isAuthenticated() && (isAdmin() || isEmployee()) && request.resource.data.get('createdBy', '') == request.auth.uid;
      allow update, delete: if isAuthenticated() && (isAdmin() || isDocOwner());
    }

    // Sales
    match /sales/{saleId} {
      allow read: if isAuthenticated() && (isAdmin() || isEmployee() || resource.data.get('createdBy', '') == request.auth.uid);
      allow create: if isAuthenticated() && (isAdmin() || isEmployee()) && request.resource.data.get('createdBy', '') == request.auth.uid;
      allow update, delete: if isAuthenticated() && (isAdmin() || isDocOwner());
    }

    // Quotes / Presupuestos (Documento no válido como factura)
    match /quotes/{quoteId} {
      allow read: if isAuthenticated() && (isAdmin() || isEmployee() || resource.data.get('createdBy', '') == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.get('createdBy', '') == request.auth.uid;
      allow update, delete: if isAuthenticated() && (isAdmin() || isDocOwner());
    }

    // Purchases
    match /purchases/{purchaseId} {
      allow read: if isAuthenticated() && (isAdmin() || isEmployee() || resource.data.get('createdBy', '') == request.auth.uid);
      allow create: if isAuthenticated() && (isAdmin() || isEmployee()) && request.resource.data.get('createdBy', '') == request.auth.uid;
      allow update, delete: if isAuthenticated() && (isAdmin() || isDocOwner());
    }

    // Notifications
    match /notifications/{notificationId} {
      allow list: if isAuthenticated() && (resource.data.get('userId', '') == request.auth.uid || isAdmin());
      allow get: if isAuthenticated() && (resource.data.get('userId', '') == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.get('userId', '') == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.get('userId', '') == request.auth.uid || isAdmin());
    }

    // Goals
    match /goals/{goalId} {
      allow read: if isAuthenticated() && (resource.data.createdBy == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isAdmin();
      allow update: if isAuthenticated() && (isAdmin() || isEmployee());
      allow delete: if isAuthenticated() && isAdmin();
    }

    // Backups
    match /backups/{backupId} {
      allow read, delete: if isAuthenticated() && (resource.data.createdBy == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isAdmin() && request.resource.data.createdBy == request.auth.uid;
    }

    // Combos
    match /combos/{comboId} {
      allow read: if isAuthenticated() && (isDocOwner() || isAdmin() || isEmployee());
      allow create: if isAuthenticated() && (isAdmin() || isEmployee()) && 
                    isValidCombo(request.resource.data) && 
                    request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() && (isDocOwner() || isAdmin()) && 
                    isValidCombo(request.resource.data) &&
                    request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAuthenticated() && (isDocOwner() || isAdmin());
    }

    // Finances (Gastos operativos, ingresos extra, balance de dinero)
    match /finances/{financeId} {
      allow read: if isAuthenticated() && (isAdmin() || isEmployee() || resource.data.get('createdBy', '') == request.auth.uid);
      allow create: if isAuthenticated() && (isAdmin() || isEmployee()) && request.resource.data.get('createdBy', '') == request.auth.uid;
      allow update, delete: if isAuthenticated() && (isAdmin() || isDocOwner());
    }

    // Cash Audits (Arqueos y recuentos de caja)
    match /cash_audits/{auditId} {
      allow read: if isAuthenticated() && (isAdmin() || isEmployee() || resource.data.get('createdBy', '') == request.auth.uid);
      allow create: if isAuthenticated() && (isAdmin() || isEmployee()) && request.resource.data.get('createdBy', '') == request.auth.uid;
      allow update, delete: if isAuthenticated() && (isAdmin() || isDocOwner());
    }

    // Work Orders (Taller de Reparaciones y Órdenes de Trabajo)
    match /work_orders/{orderId} {
      // Allow public read for tracking with order ID, and full read for authenticated staff
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // Repair Quotes (Cotizaciones y Presupuestos de Reparación de Taller)
    match /repair_quotes/{quoteId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // Users
    match /users/{userId} {
      // Allow reading own profile or any profile if admin
      allow read: if isOwner(userId) || isAdmin();

      // Allow creating a user profile if authenticated, owner, and role is specified as 'employee' or 'admin'.
      allow create: if isAuthenticated() && isOwner(userId) && request.resource.data.role in ['admin', 'employee'];

      // Allow updating own profile, or any user's profile if admin.
      allow update: if isAuthenticated() && (isAdmin() || isOwner(userId));
    }
  }
}
