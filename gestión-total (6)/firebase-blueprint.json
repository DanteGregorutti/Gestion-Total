{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Un producto en el inventario",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "codigo": { "type": "string" },
        "procedencia": { "type": "string", "enum": ["Legítimo", "Genérico", "Importado"] },
        "estado": { "type": "string", "enum": ["Nuevo", "Usado"] },
        "cantidad": { "type": "number" },
        "descripcion": { "type": "string" },
        "ubicacion": { "type": "string" },
        "almacenId": { "type": "string" },
        "precio": { "type": "number" },
        "costo": { "type": "number" },
        "imagenUrl": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastMovementAt": { "type": "string", "format": "date-time" }
      },
      "required": ["codigo", "procedencia", "estado", "cantidad", "descripcion", "ubicacion", "almacenId", "precio", "createdBy"]
    },
    "Warehouse": {
      "title": "Warehouse",
      "description": "Un almacén o depósito",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string" },
        "descripcion": { "type": "string" },
        "ubicacion": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nombre", "createdBy"]
    },
    "Movement": {
      "title": "Movement",
      "description": "Registro de entrada o salida de stock",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "productNombre": { "type": "string" },
        "tipo": { "type": "string", "enum": ["entrada", "salida", "venta", "compra", "ajuste"] },
        "cantidad": { "type": "number" },
        "fecha": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "notas": { "type": "string" }
      },
      "required": ["productId", "tipo", "cantidad", "fecha", "createdBy"]
    },
    "Client": {
      "title": "Client",
      "description": "Un cliente del negocio",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string" },
        "email": { "type": "string" },
        "telefono": { "type": "string" },
        "direccion": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["nombre", "createdBy"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Un proveedor del negocio",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string" },
        "contacto": { "type": "string" },
        "email": { "type": "string" },
        "telefono": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["nombre", "createdBy"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Registro de una venta",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "productNombre": { "type": "string" },
        "cantidad": { "type": "number" },
        "precio": { "type": "number" },
        "total": { "type": "number" },
        "clientId": { "type": "string" },
        "clientNombre": { "type": "string" },
        "fecha": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["productId", "cantidad", "precio", "total", "fecha", "createdBy"]
    },
    "Quote": {
      "title": "Quote",
      "description": "Cotización o presupuesto de venta no válido como factura",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "numero": { "type": "string" },
        "clientId": { "type": "string" },
        "clientNombre": { "type": "string" },
        "clientTelefono": { "type": "string" },
        "clientEmail": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "descuento": { "type": "number" },
        "total": { "type": "number" },
        "fecha": { "type": "string", "format": "date-time" },
        "validezDias": { "type": "number" },
        "estado": { "type": "string", "enum": ["pendiente", "aceptada", "rechazada"] },
        "notas": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["numero", "clientNombre", "items", "total", "fecha", "createdBy"]
    },
    "Purchase": {
      "title": "Purchase",
      "description": "Registro de una compra",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "productNombre": { "type": "string" },
        "cantidad": { "type": "number" },
        "costo": { "type": "number" },
        "total": { "type": "number" },
        "supplierId": { "type": "string" },
        "proveedor": { "type": "string" },
        "fecha": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["productId", "cantidad", "costo", "total", "fecha", "createdBy"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Notificación interna",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "titulo": { "type": "string" },
        "mensaje": { "type": "string" },
        "tipo": { "type": "string", "enum": ["info", "warning", "error", "success", "low_stock", "inactivity"] },
        "leido": { "type": "boolean" },
        "fecha": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" },
        "productId": { "type": "string" }
      },
      "required": ["titulo", "mensaje", "tipo", "leido", "fecha", "userId"]
    },
    "Goal": {
      "title": "Goal",
      "description": "Objetivo de negocio",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "titulo": { "type": "string" },
        "tipo": { "type": "string", "enum": ["ventas_monto", "ventas_unidades"] },
        "objetivo": { "type": "number" },
        "actual": { "type": "number" },
        "mes": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["titulo", "tipo", "objetivo", "actual", "mes", "createdBy"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Perfil de usuario",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "employee"] }
      },
      "required": ["uid", "email", "role"]
    },
    "Backup": {
      "title": "Backup",
      "description": "Copia de seguridad en la nube",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "data": { "type": "string" },
        "fecha": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" },
        "nombre": { "type": "string" }
      },
      "required": ["data", "fecha", "createdBy", "nombre"]
    },
    "Combo": {
      "title": "Combo",
      "description": "Un conjunto de productos con un precio total fijo",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string" },
        "precioTotal": { "type": "number" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "productId": { "type": "string" },
              "productNombre": { "type": "string" },
              "cantidad": { "type": "number" }
            }
          }
        },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nombre", "precioTotal", "items", "createdBy"]
    },
    "FinanceTransaction": {
      "title": "FinanceTransaction",
      "description": "Movimiento financiero, gasto operativo o ingreso extra del negocio",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tipo": { "type": "string", "enum": ["ingreso", "egreso"] },
        "categoria": { "type": "string" },
        "concepto": { "type": "string" },
        "monto": { "type": "number" },
        "metodo": { "type": "string", "enum": ["efectivo", "transferencia", "tarjeta", "otro"] },
        "fecha": { "type": "string", "format": "date-time" },
        "notas": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tipo", "categoria", "concepto", "monto", "fecha", "createdBy"]
    },
    "CashAudit": {
      "title": "CashAudit",
      "description": "Arqueo y recuento físico de caja o dinero del negocio",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fecha": { "type": "string", "format": "date-time" },
        "totalEfectivo": { "type": "number" },
        "totalDigital": { "type": "number" },
        "totalContado": { "type": "number" },
        "totalEsperado": { "type": "number" },
        "diferencia": { "type": "number" },
        "desglose": { "type": "object" },
        "notas": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fecha", "totalEfectivo", "totalContado", "createdBy"]
    }
  },
  "firestore": {
    "/products/{productId}": { "schema": "Product", "description": "Colección de productos" },
    "/warehouses/{warehouseId}": { "schema": "Warehouse", "description": "Colección de almacenes" },
    "/movements/{movementId}": { "schema": "Movement", "description": "Colección de movimientos de stock" },
    "/sales/{saleId}": { "schema": "Sale", "description": "Colección de ventas" },
    "/purchases/{purchaseId}": { "schema": "Purchase", "description": "Colección de compras" },
    "/users/{userId}": { "schema": "UserProfile", "description": "Colección de perfiles de usuario" },
    "/clients/{clientId}": { "schema": "Client", "description": "Colección de clientes" },
    "/suppliers/{supplierId}": { "schema": "Supplier", "description": "Colección de proveedores" },
    "/notifications/{notificationId}": { "schema": "Notification", "description": "Colección de notificaciones" },
    "/goals/{goalId}": { "schema": "Goal", "description": "Colección de objetivos" },
    "/backups/{backupId}": { "schema": "Backup", "description": "Colección de copias de seguridad" },
    "/combos/{comboId}": { "schema": "Combo", "description": "Colección de combos de productos" },
    "/finances/{financeId}": { "schema": "FinanceTransaction", "description": "Colección de movimientos financieros y gastos" },
    "/cash_audits/{auditId}": { "schema": "CashAudit", "description": "Colección de arqueos y recuentos de caja" }
  }
}
